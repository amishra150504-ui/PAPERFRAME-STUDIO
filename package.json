{
  "name": "paperframe-studio",
  "productName": "Paperframe Studio",
  "description": "Private A4 photo layout and PDF editing studio for Windows.",
  "author": "Ayush Mishra",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/generate-seo.mjs",
    "desktop:dev": "electron .",
    "desktop:icon": "node scripts/create-desktop-icon.mjs",
    "desktop:build": "npm run desktop:icon && npm run build && electron-builder --win portable",
    "preview": "vite preview",
    "test": "node scripts/smoke-test.mjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.468.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.4.624",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "^6.0.1"
  },
  "devDependencies": {
    "electron": "^37.2.4",
    "electron-builder": "^26.0.12",
    "png-to-ico": "^3.0.1",
    "vite": "^6.0.5"
  },
  "build": {
    "appId": "studio.paperframe.desktop",
    "productName": "Paperframe Studio",
    "asar": true,
    "directories": { "output": "release", "buildResources": "build" },
    "files": ["electron/**/*", "package.json"],
    "extraResources": [{ "from": "dist", "to": "app-dist" }],
    "win": {
      "target": "portable",
      "icon": "build/paperframe.ico",
      "artifactName": "Paperframe-Studio-${version}-Portable.${ext}"
    }
  }
}
